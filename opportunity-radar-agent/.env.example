# Local application settings. Copy this file to .env; never commit .env.
APP_NAME=Opportunity Radar Agent
DATABASE_URL=sqlite:///./opportunity_radar.db
LOG_LEVEL=INFO
LOG_FORMAT=json
SLOW_REQUEST_MS=1000

# Optional: the base import/recommendation demo works without an API key.
# Add your own DeepSeek key later to enable higher-quality extraction,
# opportunity chat, growth-memory generation and AI progress planning.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_THINKING=disabled
LLM_MAX_TOKENS=4096
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional WeChat-search MCP service.
WEIXIN_SEARCH_MCP_TRANSPORT=http
WEIXIN_SEARCH_MCP_URL=http://localhost:8809/mcp
WEIXIN_SEARCH_MAX_RESULTS=5

# Optional web search for current-information checks.
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_COUNT=5
